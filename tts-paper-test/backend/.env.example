# TSS AI测试平台 - 环境变量配置

# 数据库 (开发用SQLite, 生产用PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./tss_dev.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/tss_prod

# JWT密钥 (生产环境必须修改！使用 openssl rand -hex 32 生成)
SECRET_KEY=your-secret-key-change-in-production

# AI模型配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Midscene.js 视觉模型
MIDSCENE_MODEL_NAME=qwen3.7-plus
MIDSCENE_MODEL_API_KEY=your-qwen-api-key
MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MIDSCENE_MODEL_FAMILY=qwen3

# 调试模式 (生产环境设为 false)
DEBUG=true

# 序列调度 (SPEC-001)
# 强制执行档位: auto=按模型配置识别 / free=全局单任务串行 / paid=允许多任务并行
MODEL_TIER=auto
# 付费模式并行泳道数 (1-8)
MAX_PARALLEL_SEQUENCES=3
# 阶段最短有效输出字符数 (低于该值判定为失败, 防止静默假成功)
MIN_STAGE_OUTPUT_CHARS=80
